---
import type { SEO } from "../types/types";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import MensTeamHero from "../components/MensTeam/MensTeamHero.astro";
import MensNextMatch from "../components/MensTeam/MensNextMatch.astro";
import MensPillars from "../components/MensTeam/MensPillars.astro";
import MensPhotoBand from "../components/MensTeam/MensPhotoBand.astro";
import MensRequirements from "../components/MensTeam/MensRequirements.astro";
import MensProcessStrip from "../components/MensTeam/MensProcessStrip.astro";
import { fixturesData } from "../data/fixtures";

/*
 * The pitch page. The application form lives on /mens-team/apply/ so this page
 * can stay short enough to read in one sitting.
 *
 * One clock for the whole render, passed down rather than read again inside the
 * match card, the same way fixtures.astro does it. The site is output: "server",
 * so "next match" stays correct per request without a rebuild.
 */
const now = new Date();

const seo: SEO = {
  title: "Men's Soccer Team Vancouver | VMSL | South Van FC",
  description:
    "South Van FC competes in the VMSL. Open trials for adult players in Vancouver. Learn about our men's training squad, eligibility, and apply online.",
  canonical: "/mens-team/",
  keywords:
    "adult soccer Vancouver, VMSL men's team Vancouver, soccer tryouts Vancouver, men's soccer team Vancouver, join soccer team Vancouver, VMSL registration Vancouver",
  ogImage: "https://www.southvanfc.com/og/og-default.png",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.southvanfc.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Men's Team",
      item: "https://www.southvanfc.com/mens-team/",
    },
  ],
};
---

<BaseLayout seo={seo}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <MensTeamHero />
  <MensNextMatch data={fixturesData} now={now} />
  <MensPillars />
  <MensPhotoBand />
  <MensRequirements />
  <MensProcessStrip />
  <Cta
    title="Apply for<br />a Trial"
    body="Trials run through the season. Send the form and we will come back to you within 48 hours."
    links={[
      { href: "/mens-team/apply/", label: "Apply Now", style: "navy" },
      {
        href: "/fixtures/",
        label: "Fixtures and Results",
        style: "outline-navy",
      },
    ]}
  />
</BaseLayout>
