---
import EvalAbout from "../../components/PlayerEval/EvalAbout.astro";
import EvalHero from "../../components/PlayerEval/EvalHero.astro";
import EvalMeta from "../../components/PlayerEval/EvalMeta.astro";
import EvalProcess from "../../components/PlayerEval/EvalProcess.astro";
import EvalRequestForm from "../../components/PlayerEval/EvalRequestForm.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const seo = {
  title: "Free Soccer Player Evaluation in Vancouver | South Van FC",
  description:
    "Book a free soccer player evaluation in Vancouver. South Van FC coaches assess technical, tactical and physical ability, U8 through adult.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.southvanfc.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Soccer Academy",
      item: "https://www.southvanfc.com/soccer-academy/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Player Evaluation",
      item: "https://www.southvanfc.com/soccer-academy/player-evaluation/",
    },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Free Soccer Player Evaluation",
  serviceType: "Soccer player evaluation",
  provider: {
    "@type": "SportsClub",
    "@id": "https://www.southvanfc.com/#sportsclub",
    name: "South Van FC",
    url: "https://www.southvanfc.com",
  },
  description:
    "A personalised player evaluation session where South Van FC coaches assess technical skills, tactical understanding, and athletic development to create an individual training plan.",
  areaServed: {
    "@type": "Place",
    name: "Vancouver, BC, Canada",
  },
  audience: {
    "@type": "Audience",
    audienceType: "Youth and adult soccer players, U8 through adult",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CAD",
    availability: "https://schema.org/InStock",
    description: "First evaluation session is free.",
    url: "https://www.southvanfc.com/soccer-academy/player-evaluation/",
  },
  url: "https://www.southvanfc.com/soccer-academy/player-evaluation/",
};
---

<BaseLayout seo={seo}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema)}
  />
  <EvalHero />
  <div class="form-wrap">
    <div class="form-panel">
      <div class="panel-header">
        <h2 class="panel-title">Evaluation Request Form</h2>
        <p class="panel-sub">
          Complete all required fields. <strong>Optional</strong> fields help us personalise
          your session.
        </p>
      </div>
      <EvalRequestForm />
    </div>
  </div>
  <EvalMeta />
  <EvalProcess />
  <EvalAbout />
</BaseLayout>
