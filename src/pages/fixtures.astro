---
import BaseLayout from "../layouts/BaseLayout.astro";
import FixturesHero from "../components/Fixtures/FixturesHero.astro";
import MatchHero from "../components/Fixtures/MatchHero.astro";
import SeasonStats from "../components/Fixtures/SeasonStats.astro";
import FixtureList from "../components/Fixtures/FixtureList.astro";
import { fixturesData } from "../data/fixtures";
import { OUR_SLUG, getClub, isoKickoff, seasonSummary, upcomingMatches } from "../lib/fixtures";
import type { SEO } from "../types/types";

/*
 * SSR, so this runs per request. Nothing here is baked in at build time,
 * which is what keeps the next match and the season record current.
 */
const { season, division } = fixturesData;
const summary = seasonSummary(fixturesData);

/* One clock for the whole render, so the countdown and the calendar's "today"
   cannot disagree by a second at a midnight boundary. */
const now = new Date();

const seo: SEO = {
  title: "Fixtures and Results | VMSL | South Van FC",
  description: `South Van FC men's team fixtures and results in ${division} for the ${season} season. Kickoff times, venues and standings from the Vancouver Metro Soccer League.`,
  canonical: "/fixtures/",
  ogType: "website",
  keywords:
    "South Van FC fixtures, VMSL fixtures, VMSL results, VMSL Division 4 standings, Vancouver Metro Soccer League, men's soccer Vancouver",
  ogImage: "https://www.southvanfc.com/og/og-default.png",
};

/*
 * SportsEvent JSON-LD, one entry per upcoming fixture. Postponed and
 * cancelled matches are already excluded by `upcomingMatches()`, since a
 * postponement with no confirmed date has nothing real to put in `startDate`.
 */
const ourClub = getClub(fixturesData, OUR_SLUG);

const sportsEventSchema = upcomingMatches(fixturesData, now).map((match) => {
  const opponent = getClub(fixturesData, match.opponentSlug);
  const home = match.isHome ? ourClub : opponent;
  const away = match.isHome ? opponent : ourClub;
  const homeName = home?.name ?? "TBC";
  const awayName = away?.name ?? "TBC";

  return {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    name: `${homeName} vs ${awayName}`,
    sport: "Soccer",
    startDate: isoKickoff(match),
    location: {
      "@type": "Place",
      name: match.venue,
    },
    homeTeam: { "@type": "SportsTeam", name: homeName },
    awayTeam: { "@type": "SportsTeam", name: awayName },
    competitor: [
      { "@type": "SportsTeam", name: homeName },
      { "@type": "SportsTeam", name: awayName },
    ],
  };
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.southvanfc.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Men's Team",
      item: "https://www.southvanfc.com/mens-team/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Fixtures and Results",
      item: "https://www.southvanfc.com/fixtures/",
    },
  ],
};
---

<BaseLayout seo={seo}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  {
    sportsEventSchema.map((schema) => (
      <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <FixturesHero season={season} division={division}>
    <MatchHero data={fixturesData} now={now} />
  </FixturesHero>

  <SeasonStats summary={summary} />

  <FixtureList data={fixturesData} now={now} />
</BaseLayout>
