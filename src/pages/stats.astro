---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamLeaders from "../components/Stats/TeamLeaders.astro";
import StatsTable, { type Column } from "../components/Stats/StatsTable.astro";
import { playersData } from "../data/players";
import { totals } from "../lib/players";
import type { SEO } from "../types/types";

const { season, players } = playersData;

const gamesPlayed: Column = { key: "gamesPlayed", label: "Games played", short: "GP", icon: "calendar", color: "#3b6fb6" };
const assists: Column = { key: "assists", label: "Assists", short: "Assists", icon: "assist", color: "#1f9d6b" };
const yellows: Column = { key: "yellows", label: "Yellow cards", short: "Yellow", icon: "yellow", color: "#f2c200" };
const reds: Column = { key: "reds", label: "Red cards", short: "Red", icon: "red", color: "#d23a2e" };

const outfieldColumns: Column[] = [
  gamesPlayed,
  { key: "goals", label: "Goals", short: "Goals", icon: "ball", color: "#12285a" },
  assists,
  { key: "mvps", label: "MVP awards", short: "MVPs", icon: "star", color: "#e8b430" },
  yellows,
  reds,
];
const keeperColumns: Column[] = [
  gamesPlayed,
  { key: "cleanSheets", label: "Clean sheets", short: "Clean sheets", icon: "shield", color: "#0e8a9c" },
  assists,
  yellows,
  reds,
];

const outfield = players.filter((player) => !player.goalkeeper);
const keepers = players.filter((player) => player.goalkeeper);
const sum = totals({ ...playersData, players: outfield });

const outfieldRows = [...outfield].sort(
  (a, b) => b.goals - a.goals || b.assists - a.assists || b.mvps - a.mvps || a.name.localeCompare(b.name),
);
const keeperRows = [...keepers].sort(
  (a, b) => b.cleanSheets - a.cleanSheets || b.gamesPlayed - a.gamesPlayed || a.name.localeCompare(b.name),
);

const seo: SEO = {
  title: "Player Stats | VMSL | South Van FC",
  description: `South Van FC men's team player stats for the ${season} season: top scorers, assists and MVP awards in the Vancouver Metro Soccer League.`,
  canonical: "/stats/",
  ogType: "website",
  keywords:
    "South Van FC stats, VMSL top scorers, VMSL MVP, Vancouver Metro Soccer League player stats",
  ogImage: "https://www.southvanfc.com/og/og-default.png",
};
---

<BaseLayout seo={seo}>
  <section class="st-hero">
    <div class="fx-shell">
      <span class="eyebrow eyebrow-gold">{season} Season</span>
      <h1 class="st-title">Player Stats</h1>
      <p class="st-intro">
        Games played, goals, assists, MVP awards, clean sheets and cards for
        South Van FC men's team players in the Vancouver Metro Soccer League.
        Goals, MVPs, clean sheets and cards come from the league's official
        records. Games played and assists are kept by the club.
      </p>
    </div>
  </section>

  <TeamLeaders data={playersData} />

  <section class="st-table-wrap" aria-labelledby="st-table-heading">
    <div class="fx-shell">
      <h2 class="st-h2" id="st-table-heading">All Players</h2>
      {
        outfieldRows.length > 0 ? (
          <StatsTable
            columns={outfieldColumns}
            rows={outfieldRows}
            totals={[null, sum.goals, sum.assists, sum.mvps, sum.yellows, sum.reds]}
          />
        ) : (
          <p class="st-empty">No player stats have been recorded yet this season.</p>
        )
      }
      {
        keeperRows.length > 0 && (
          <>
            <h2 class="st-h2 st-h2-keepers" id="st-keepers-heading">Goalkeepers</h2>
            <StatsTable columns={keeperColumns} rows={keeperRows} />
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .st-hero {
    background: linear-gradient(160deg, var(--navy-dark), var(--navy));
    padding: 72px 80px 56px;
    color: var(--white);
  }
  .st-title {
    margin: 10px 0 14px;
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.05;
  }
  .st-intro {
    max-width: 620px;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }
  .st-table-wrap {
    padding: 56px 80px 72px;
    background: var(--white);
  }
  .st-h2 {
    margin: 0 0 20px;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--navy);
  }
  .st-h2-keepers {
    margin-top: 48px;
  }
  .st-empty {
    margin: 0;
    color: var(--text-mid);
  }
  @media (max-width: 960px) {
    .st-hero {
      padding: 56px 28px 44px;
    }
    .st-table-wrap {
      padding: 44px 28px 56px;
    }
  }
  @media (max-width: 640px) {
    .st-hero {
      padding: 44px 20px 36px;
    }
    .st-title {
      font-size: 36px;
    }
    .st-table-wrap {
      padding: 36px 20px 48px;
    }
  }
</style>
