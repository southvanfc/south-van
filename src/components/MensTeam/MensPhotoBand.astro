---
import { Image } from "astro:assets";
import { bandImage } from "../../lib/team-images";

/*
 * One statement line over a full-bleed photo. The section always renders: with
 * no photo it is a navy gradient band carrying the same line, so the page keeps
 * its light, dark, light rhythm and does not change shape the day a file lands.
 */

const BAND_ALT = "South Van FC players at a midweek training session";
---

<section class:list={["photo-band", !bandImage && "is-noimage"]}>
  {
    bandImage && (
      <div class="band-media" aria-hidden="true">
        <Image
          src={bandImage}
          alt={BAND_ALT}
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="lazy"
        />
      </div>
    )
  }

  <p class="band-line">
    Wednesday nights. Weekend fixtures. Same standard every time.
  </p>
</section>

<style>
  .photo-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 3px solid var(--gold);
    padding: 108px 80px;
    display: flex;
    align-items: center;
  }
  .photo-band.is-noimage {
    padding: 76px 80px;
    background: linear-gradient(150deg, #011f4a 0%, #012860 52%, #011a3f 100%);
  }

  .band-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .band-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Scrim, so the line clears 4.5:1 whatever the photo turns out to be */
  .band-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(1, 31, 74, 0.92) 0%,
      rgba(1, 31, 74, 0.78) 55%,
      rgba(1, 31, 74, 0.5) 100%
    );
  }

  .band-line {
    position: relative;
    max-width: 22ch;
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: #fff;
    border-left: 3px solid var(--gold);
    padding-left: 26px;
  }

  @media (max-width: 960px) {
    .photo-band {
      padding: 72px 28px;
    }
    .photo-band.is-noimage {
      padding: 56px 28px;
    }
    .band-line {
      max-width: none;
      padding-left: 18px;
    }
  }
</style>
