---
import { Image } from "astro:assets";
import { heroImage } from "../../lib/team-images";

/*
 * The headline used to be painted at rgba(255,255,255,0.18), which made the
 * page's only h1 a watermark. The ghosting now lives on a separate decorative
 * span behind the grid, the same trick Squads.astro uses, so the effect stays
 * and the headline is readable.
 */

const HERO_ALT = "South Van FC men's squad before a VMSL fixture";

const pills = ["18 and over", "VMSL Division 4A", "Open Trials"];
---

<section class="mens-hero">
  <div class="field-pattern" aria-hidden="true"></div>
  <div class="accent-bar" aria-hidden="true"></div>
  <span class="hero-ghost" aria-hidden="true">SVFC</span>

  <div class:list={["hero-inner", !heroImage && "is-noimage"]}>
    <div class="hero-left">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M9 18l6-6-6-6"></path></svg
        >
        <span class="crumb-cur">Men's Team</span>
      </nav>

      <span class="eyebrow eyebrow-gold">Men's Team</span>
      <h1 class="hero-title">Vancouver <br /> Men's Soccer</h1>

      <p class="hero-body">
        South Van FC plays in the Vancouver Metro Soccer League. We train every
        week, we select on merit, and we expect you to compete for your place.
        If that reads right, apply.
      </p>

      <div class="hero-ctas">
        <a href="/mens-team/apply/" class="btn btn-gold">
          Apply for a Trial
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
        <a href="/fixtures/" class="btn btn-outline-white">
          Fixtures and Results
        </a>
      </div>

      <div class="hero-pills">
        {pills.map((p) => <span class="pill pill-white">{p}</span>)}
      </div>
    </div>

    {
      heroImage && (
        <div class="hero-photo">
          <Image
            src={heroImage}
            alt={HERO_ALT}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 960px) 100vw, 46vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>

  <div class="hero-stripe" aria-hidden="true"></div>
</section>

<style>
  .mens-hero {
    background: #011f4a;
    padding: 72px 80px 0;
    position: relative;
    overflow: hidden;
  }

  .field-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 59px,
        rgba(255, 255, 255, 0.02) 59px,
        rgba(255, 255, 255, 0.02) 60px
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 59px,
        rgba(255, 255, 255, 0.02) 59px,
        rgba(255, 255, 255, 0.02) 60px
      );
  }

  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #e8b430 0%, rgba(232, 180, 48, 0) 100%);
  }

  .hero-ghost {
    position: absolute;
    right: 24px;
    bottom: -40px;
    font-size: 240px;
    line-height: 1;
    letter-spacing: -6px;
    font-weight: 800;
    color: #fff;
    opacity: 0.05;
    user-select: none;
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 46%);
    gap: 72px;
    align-items: center;
    position: relative;
    z-index: 2;
    padding-bottom: 64px;
  }
  /* No photo dropped in yet, so the copy takes the full width rather than
     leaving a column of empty navy */
  .hero-inner.is-noimage {
    grid-template-columns: 1fr;
  }
  .hero-inner.is-noimage .hero-left {
    max-width: 720px;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 24px;
  }
  .crumb a {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.2s;
  }
  .crumb a:hover {
    color: rgba(255, 255, 255, 0.65);
  }
  .crumb-cur {
    color: #e8b430;
  }

  .hero-title {
    font-size: clamp(46px, 5.4vw, 82px);
    line-height: 0.94;
    letter-spacing: -1px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 22px;
  }

  .hero-body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 46ch;
    border-left: 2px solid rgba(232, 180, 48, 0.4);
    padding-left: 20px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  /* Landscape, so the photo sits beside the copy rather than setting the
     hero's height. A portrait slot here made the section about 875px tall on a
     1440px screen and cropped the sides off a wide source image. The
     max-height stops the same thing happening again on very wide screens,
     where 46% of the viewport gets tall enough to take over. */
  .hero-photo {
    position: relative;
    aspect-ratio: 3 / 2;
    max-height: 440px;
    margin-left: auto;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 3px solid #e8b430;
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-stripe {
    height: 6px;
    background: repeating-linear-gradient(
      90deg,
      #e8b430 0,
      #e8b430 40px,
      transparent 40px,
      transparent 48px
    );
    position: relative;
    z-index: 2;
  }

  @media (max-width: 960px) {
    .mens-hero {
      padding: 56px 28px 0;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 48px;
    }
    .hero-ghost {
      font-size: 160px;
      bottom: -28px;
    }
    .hero-photo {
      max-height: none;
    }
    .hero-body {
      font-size: 15px;
    }
  }
</style>
