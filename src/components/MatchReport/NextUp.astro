---
import type { FixturesData, Match } from "../../types/types";
import Crest from "../Fixtures/Crest.astro";
import LocationButton from "../Fixtures/LocationButton.astro";
import {
  OUR_SLUG,
  formatLongDate,
  formatTime,
  getClub,
} from "../../lib/fixtures";

/*
 * Where the story goes next. Always the next fixture at request time, so an
 * old report points at whatever is coming up rather than at a game that has
 * since been played. Hidden by the page once the season is over.
 *
 * Home team on the left, as everywhere else on the site.
 */

interface Props {
  data: FixturesData;
  match: Match;
}

const { data, match } = Astro.props;

const us = getClub(data, OUR_SLUG);
const opponent = getClub(data, match.opponentSlug);

const home = match.isHome ? us : opponent;
const away = match.isHome ? opponent : us;
const homeSlug = match.isHome ? OUR_SLUG : match.opponentSlug;
const awaySlug = match.isHome ? match.opponentSlug : OUR_SLUG;
---

<section class="mr-block" aria-labelledby="mr-next-h">
  <h2 class="mr-h" id="mr-next-h">Next up</h2>
  <div class="mr-next">
    <div class="mr-next-teams">
      <div class="mr-next-team">
        <Crest club={home} slug={homeSlug} />
        <span>{home?.name ?? homeSlug}</span>
      </div>
      <span class="mr-next-v" aria-hidden="true">v</span>
      <div class="mr-next-team">
        <Crest club={away} slug={awaySlug} />
        <span>{away?.name ?? awaySlug}</span>
      </div>
    </div>

    <dl class="mr-next-meta">
      <div>
        <dt>Date</dt>
        <dd>{formatLongDate(match.date)}</dd>
      </div>
      <div>
        <dt>Kickoff</dt>
        <dd>{formatTime(match.time)}</dd>
      </div>
      <div>
        <dt>Venue</dt>
        <dd class="mr-next-venue">
          <span>{match.venue}</span>
          <LocationButton venue={match.venue} />
        </dd>
      </div>
    </dl>

    <div class="mr-next-actions">
      <a href="/fixtures/" class="btn btn-navy btn-sm">Fixtures and results</a>
      <a href="/fixtures/next-match.ics" class="btn btn-outline-navy btn-sm">
        Add to calendar
      </a>
    </div>
  </div>
</section>

<style>
  .mr-next {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--lt-gray);
    border-radius: 12px;
  }
  .mr-next-teams {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
  }
  .mr-next-team {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--navy-dark);
  }
  .mr-next-v {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fx-muted);
  }
  .mr-next-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    margin: 0;
  }
  .mr-next-meta dt {
    margin-bottom: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fx-muted);
  }
  .mr-next-meta dd {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-dark);
  }
  .mr-next-venue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .mr-next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
