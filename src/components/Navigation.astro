---
interface NavChild {
  href: string;
  label: string;
}

interface NavItem {
  key: string;
  label: string;
  /** Own page. On a group this is the overview, listed first in its menu. */
  href: string;
  /** Present on groups, which render as a dropdown on desktop */
  children?: NavChild[];
}

/*
 * Grouped the way club and league sites do it (Canucks: Team, Standings with
 * Scores and Stats underneath; TSN: a menu per sport): a topic gets one top
 * level entry and its pages sit under it. That keeps the bar short as pages
 * are added, so a new page goes into a group rather than onto the bar.
 */
const links: NavItem[] = [
  { key: "home", href: "/", label: "Home" },
  {
    key: "academy",
    href: "/soccer-academy/",
    label: "Soccer Academy",
    children: [
      { href: "/soccer-academy/", label: "Overview" },
      { href: "/soccer-academy/pricing/", label: "Pricing" },
      { href: "/academy-app/", label: "Academy App" },
    ],
  },
  {
    key: "mens-team",
    href: "/mens-team/",
    label: "Men's Team",
    children: [
      { href: "/mens-team/", label: "Overview" },
      { href: "/fixtures/", label: "Fixtures and Results" },
      { href: "/stats/", label: "Player Stats" },
    ],
  },
  { key: "coaches", href: "/our-coaches/", label: "Coaches" },
  { key: "blog", href: "/blogs/", label: "Blogs" },
];

const pathname = Astro.url.pathname;

// Every href in the nav, tied back to the top level item that owns it
const entries = links.flatMap((item) => [
  { key: item.key, href: item.href },
  ...(item.children ?? []).map((child) => ({ key: item.key, href: child.href })),
]);

// Most specific href that is a prefix of (or equals) the current pathname
interface Best {
  key: string;
  href: string;
  len: number;
}

// The type argument stops TypeScript picking the overload where the
// accumulator has the entry's own type, which has no `len`
const best = entries.reduce<Best>(
  (found, { key, href }) => {
    const matches = href === "/" ? pathname === "/" : pathname.startsWith(href);
    return matches && href.length > found.len ? { key, href, len: href.length } : found;
  },
  { key: "", href: "", len: 0 },
);
const activeKey = best.key;
const activeHref = best.href;
---

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">
    <div class="nav-mark">
      <img
        src="/assets/blue.png"
        alt="South Van FC crest"
        width="48"
        height="48"
      />
    </div>
    <span class="nav-brand">South Van FC</span>
  </a>

  <ul class="nav-links">
    {
      links.map((item) =>
        item.children ? (
          <li class="nav-dropdown nav-group">
            <button
              type="button"
              class:list={["nav-group-toggle", { active: activeKey === item.key }]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {item.label} <span class="nav-dropdown-arrow">▾</span>
            </button>
            <ul class="nav-dropdown-menu nav-dropdown-menu--left" role="menu">
              {item.children.map((child) => (
                <li role="none">
                  <a
                    href={child.href}
                    role="menuitem"
                    class:list={[{ active: activeHref === child.href }]}
                    aria-current={activeHref === child.href ? "page" : undefined}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a href={item.href} class:list={[{ active: activeKey === item.key }]}>
              {item.label}
            </a>
          </li>
        ),
      )
    }
    <li class="nav-dropdown">
      <button
        class="nav-cta nav-dropdown-toggle"
        aria-expanded="false"
        aria-haspopup="true"
      >
        Apply Now <span class="nav-dropdown-arrow">▾</span>
      </button>
      <ul class="nav-dropdown-menu" role="menu">
        <li role="none">
          <a href="/mens-team/apply/" role="menuitem">Men's Squad</a>
        </li>
        <li role="none">
          <a href="/soccer-academy/player-evaluation/" role="menuitem"
            >Soccer Academy</a
          >
        </li>
      </ul>
    </li>
  </ul>

  <button
    class="nav-hamburger"
    id="hamburger"
    aria-label="Open menu"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<!-- Mobile drawer. Groups are always open here: three links a group is short
     enough that an accordion would only add a tap. -->
<div class="nav-drawer" id="drawer" aria-hidden="true">
  {
    links.map((item) =>
      item.children ? (
        <div class="drawer-group">
          <span class="drawer-group-label">{item.label}</span>
          {item.children.map((child) => (
            <a
              href={child.href}
              class:list={["drawer-child", { active: activeHref === child.href }]}
              aria-current={activeHref === child.href ? "page" : undefined}
            >
              {child.label}
            </a>
          ))}
        </div>
      ) : (
        <a href={item.href} class:list={[{ active: activeKey === item.key }]}>
          {item.label}
        </a>
      ),
    )
  }
  <a href="/mens-team/apply/" class="drawer-cta">Apply: Men's Squad</a>
  <a href="/soccer-academy/player-evaluation/" class="drawer-cta"
    >Apply: Soccer Academy</a
  >
</div>

<script>
  const ham = document.getElementById("hamburger")!;
  const drawer = document.getElementById("drawer")!;

  // Dropdowns: the Apply menu and each nav group. Only one open at a time.
  const dropdowns = Array.from(
    document.querySelectorAll<HTMLElement>(".nav-links .nav-dropdown"),
  ).map((root) => ({
    root,
    toggle: root.querySelector<HTMLButtonElement>("button")!,
    menu: root.querySelector<HTMLElement>(".nav-dropdown-menu")!,
  }));

  function setOpen(target: (typeof dropdowns)[number], open: boolean) {
    target.toggle.setAttribute("aria-expanded", String(open));
    target.menu.classList.toggle("open", open);
  }

  function closeAll(except?: (typeof dropdowns)[number]) {
    for (const dropdown of dropdowns) {
      if (dropdown !== except) setOpen(dropdown, false);
    }
  }

  for (const dropdown of dropdowns) {
    dropdown.toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = dropdown.toggle.getAttribute("aria-expanded") === "true";
      closeAll(dropdown);
      setOpen(dropdown, !isOpen);
    });

    // Hover opens groups on a pointer device; click and keyboard still work
    if (dropdown.root.classList.contains("nav-group")) {
      dropdown.root.addEventListener("mouseenter", () => {
        if (window.matchMedia("(hover: hover)").matches) {
          closeAll(dropdown);
          setOpen(dropdown, true);
        }
      });
      dropdown.root.addEventListener("mouseleave", () => {
        if (window.matchMedia("(hover: hover)").matches) setOpen(dropdown, false);
      });
    }
  }

  document.addEventListener("click", (e) => {
    if (!dropdowns.some(({ root }) => root.contains(e.target as Node))) closeAll();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = dropdowns.find(({ toggle }) => toggle.getAttribute("aria-expanded") === "true");
    if (open) {
      closeAll();
      open.toggle.focus();
    }
  });

  ham.addEventListener("click", () => {
    const isOpen = ham.classList.toggle("open");
    drawer.classList.toggle("open", isOpen);
    ham.setAttribute("aria-expanded", String(isOpen));
    drawer.setAttribute("aria-hidden", String(!isOpen));
  });

  // Close on link click
  drawer.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      ham.classList.remove("open");
      drawer.classList.remove("open");
      ham.setAttribute("aria-expanded", "false");
      drawer.setAttribute("aria-hidden", "true");
    }),
  );

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (!ham.contains(e.target as Node) && !drawer.contains(e.target as Node)) {
      ham.classList.remove("open");
      drawer.classList.remove("open");
    }
  });
</script>
