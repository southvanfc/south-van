---
// src/components/Homepage/Hero.astro
---

<section class="hero">
  <div class="field-pattern" aria-hidden="true"></div>
  <div class="accent-bar" aria-hidden="true"></div>

  <div class="hero-inner">
    <span class="eyebrow eyebrow-gold">Vancouver Football Club</span>

    <h1 class="hero-title">South Van FC</h1>

    <p class="hero-body">
      A soccer club developing players from U8 through adult in South
      Vancouver. We also run a competitive men's side in the VMSL.
    </p>

    <div class="hero-cta-block">
      <p class="hero-cta-label">Who are you here for?</p>
      <div class="hero-actions">
        <a href="/soccer-academy/" class="btn btn-gold">
          <span class="btn-main">Soccer Academy</span>
          <span class="btn-sub">Ages U8–Adult</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
        <a href="/mens-team/" class="btn btn-outline-white">
          <span class="btn-main">Men's Team</span>
          <span class="btn-sub">Adult · VMSL</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </div>

  <div class="hero-stripe" aria-hidden="true"></div>
</section>

<style>
  .hero {
    background: #011f4a;
    padding: 88px 80px 0;
    position: relative;
    overflow: hidden;
  }

  .field-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 59px,
        rgba(255, 255, 255, 0.02) 59px,
        rgba(255, 255, 255, 0.02) 60px
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 59px,
        rgba(255, 255, 255, 0.02) 59px,
        rgba(255, 255, 255, 0.02) 60px
      );
  }

  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #e8b430 0%, rgba(232, 180, 48, 0) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding-bottom: 72px;
  }

  .hero-title {
    font-size: clamp(46px, 5.4vw, 82px);
    line-height: 0.94;
    letter-spacing: -1px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 22px;
  }

  .hero-body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 46ch;
    border-left: 2px solid rgba(232, 180, 48, 0.4);
    padding-left: 20px;
    margin-bottom: 44px;
  }

  .hero-cta-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-cta-label {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-main {
    display: block;
    line-height: 1.2;
  }

  .btn-sub {
    display: block;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.5px;
    opacity: 0.72;
    margin-top: 2px;
  }

  .hero-stripe {
    height: 6px;
    background: repeating-linear-gradient(
      90deg,
      #e8b430 0,
      #e8b430 40px,
      transparent 40px,
      transparent 48px
    );
    position: relative;
    z-index: 2;
  }

  @media (max-width: 960px) {
    .hero {
      padding: 64px 28px 0;
    }
    .hero-inner {
      padding-bottom: 56px;
    }
    .hero-body {
      font-size: 15px;
    }
  }
</style>
