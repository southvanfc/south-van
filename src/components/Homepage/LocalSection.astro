---
// src/components/Homepage/LocalSection.astro

const claims = [
  "Built by South Vancouver, for South Vancouver.",
  "Development pathway from U8 through adult.",
  "Competitive men's side in the VMSL.",
];

const facts = [
  { label: "Location", value: "South Vancouver, BC" },
  { label: "Academy Age Range", value: "U8 to Adult" },
  { label: "League", value: "VMSL Men's Open" },
  { label: "Founded", value: "2023" },
];

const links = [
  { href: "/soccer-academy/", label: "Soccer Academy" },
  { href: "/mens-team/", label: "Men's Team" },
  { href: "/south-vancouver/", label: "Our Neighbourhood" },
];
---

<section class="local">
  <div class="local-inner">
    <div class="local-col">
      <span class="eyebrow eyebrow-navy">South Vancouver</span>
      <h2 class="col-title">Our Neighbourhood</h2>
      <ul class="claim-list">
        {
          claims.map((item) => (
            <li>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="local-links">
        {
          links.map(({ href, label }) => (
            <a href={href} class="local-link">
              {label}
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <div class="divider" aria-hidden="true"></div>

    <div class="local-col">
      <span class="eyebrow eyebrow-navy">At a Glance</span>
      <h2 class="col-title">The Facts</h2>
      <dl class="fact-list">
        {
          facts.map(({ label, value }) => (
            <div class="fact-row">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .local {
    background: #fff;
    padding: 96px 80px;
    position: relative;
  }

  .local::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      var(--gold) 0,
      var(--gold) 40px,
      transparent 40px,
      transparent 48px
    );
  }

  .local-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    gap: 64px;
  }

  .divider {
    position: relative;
    background: repeating-linear-gradient(
      180deg,
      var(--lt-gray) 0,
      var(--lt-gray) 10px,
      transparent 10px,
      transparent 16px
    );
  }

  .divider::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--gold);
    border-radius: 50%;
    background: #fff;
    transform: translate(-50%, -50%);
  }

  .col-title {
    font-family: "Inter Variable", sans-serif;
    font-size: clamp(32px, 3.2vw, 44px);
    line-height: 0.98;
    letter-spacing: 0.5px;
    color: var(--navy-dark);
    margin-bottom: 26px;
  }

  .claim-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .claim-list li {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-mid);
  }
  .claim-list svg {
    color: var(--gold);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .local-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
  }

  .local-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .local-link:hover {
    border-bottom-color: var(--navy);
  }

  .fact-list {
    display: flex;
    flex-direction: column;
  }
  .fact-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--lt-gray);
  }
  .fact-row:first-child {
    border-top: 1px solid var(--lt-gray);
  }
  .fact-row dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-light);
    flex-shrink: 0;
  }
  .fact-row dd {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--navy-dark);
    text-align: right;
  }

  @media (max-width: 960px) {
    .local {
      padding: 64px 28px;
    }
    .local-inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .divider {
      height: 1px;
      background: repeating-linear-gradient(
        90deg,
        var(--lt-gray) 0,
        var(--lt-gray) 10px,
        transparent 10px,
        transparent 16px
      );
    }
  }
</style>
