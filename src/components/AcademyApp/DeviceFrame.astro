---
// src/components/AcademyApp/DeviceFrame.astro
// Screenshot frame with a designed placeholder. Pass `image` once a real
// screenshot lands in src/assets/academy-app/ (see academy-app-images.ts);
// until then it renders the placeholder fill automatically.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  label?: string;
  image?: ImageMetadata;
  alt?: string;
  variant?: "browser" | "phone";
  aspect?: string;
}

const { label, image, alt, variant = "browser", aspect } = Astro.props;
// Match the frame's shape to the screenshot's own dimensions so the whole
// image shows with no cropping. Falls back to a fixed ratio for the
// placeholder state, where there is no image to size against.
const resolvedAspect =
  aspect ??
  (image
    ? `${image.width} / ${image.height}`
    : variant === "phone"
      ? "9/18.5"
      : "16/10");
---

<div class:list={["device-frame", `is-${variant}`]}>
  {
    variant === "browser" ? (
      <div class="device-chrome">
        <span class="device-dot" />
        <span class="device-dot" />
        <span class="device-dot" />
        <span class="device-url" />
      </div>
    ) : (
      <div class="device-notch" />
    )
  }

  <div class="device-body" style={`aspect-ratio: ${resolvedAspect};`}>
    {
      image ? (
        <Image
          src={image}
          alt={alt ?? label ?? "Academy App screenshot"}
          widths={variant === "phone" ? [320, 480, 640] : [480, 800, 1200]}
          sizes={variant === "phone" ? "260px" : "(max-width: 960px) 100vw, 46vw"}
        />
      ) : (
        <div class="device-placeholder">
          {label && <span class="device-chip">{label}</span>}
          <svg
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="14" rx="2"></rect>
            <path d="M3 15l4.5-4.5a1.5 1.5 0 0 1 2.12 0L15 15"></path>
            <circle cx="16" cy="9" r="1.5"></circle>
            <path d="M2 20h20"></path>
          </svg>
          <span class="device-caption">Screenshot Coming Soon</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .device-frame {
    background: var(--white);
    border: 1px solid var(--lt-gray);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(1, 52, 120, 0.12);
  }

  .device-frame.is-phone {
    max-width: 240px;
    margin: 0 auto;
    border-radius: 26px;
    border-width: 6px;
    border-color: var(--navy-dark);
  }

  /* ── Browser chrome ── */
  .device-chrome {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    background: var(--off-white);
    border-bottom: 1px solid var(--lt-gray);
  }

  .device-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mid-gray);
    flex-shrink: 0;
  }

  .device-url {
    margin-left: 10px;
    height: 14px;
    width: 55%;
    border-radius: 6px;
    background: var(--lt-gray);
  }

  /* ── Phone notch ── */
  .device-notch {
    display: flex;
    justify-content: center;
    padding: 8px 0 4px;
    background: var(--navy-dark);
  }
  .device-notch::before {
    content: "";
    width: 60px;
    height: 6px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.25);
  }

  .device-body {
    position: relative;
    width: 100%;
    background:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 59px,
        rgba(1, 52, 120, 0.03) 59px,
        rgba(1, 52, 120, 0.03) 60px
      ),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 59px,
        rgba(1, 52, 120, 0.03) 59px,
        rgba(1, 52, 120, 0.03) 60px
      ),
      var(--off-white);
  }

  .device-body :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .device-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--mid-gray);
    padding: 16px;
    text-align: center;
  }

  .device-chip {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--gold-pale);
    border: 1px solid rgba(232, 180, 48, 0.4);
    border-radius: 100px;
    padding: 5px 13px;
    margin-bottom: 2px;
  }

  .device-caption {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-light);
  }
</style>
