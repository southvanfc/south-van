---
// src/components/AcademyApp/AppWhy.astro
const before = [
  "Attendance tracked on paper or scattered spreadsheets",
  "Assessments that looked different from coach to coach",
  "Parents left guessing how their player is developing",
];

const after = [
  "Attendance logged in seconds, from any session",
  "One scoring system, used the same way across every coach",
  "Players and parents see progress as it happens",
];
---

<section class="app-why">
  <div class="why-text">
    <span class="eyebrow eyebrow-navy">Why We Built It</span>
    <h2 class="section-title">One System, Not a Binder Full of Spreadsheets</h2>
    <p class="section-body">
      Running a growing academy on paper sign in sheets and personal notes
      does not scale. Coaches were tracking development their own way,
      and parents had no clear window into how their player was
      progressing.
    </p>
    <p class="section-body" style="margin-top: 18px">
      So we built our own platform. One place for sessions, attendance,
      assessments and notes, built around how our coaches actually work.
    </p>
  </div>

  <div class="why-compare">
    <div class="compare-card compare-before">
      <span class="compare-lbl">Before</span>
      <ul>
        {before.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="compare-card compare-after">
      <span class="compare-lbl">After</span>
      <ul>
        {after.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .app-why {
    background: var(--off-white);
    padding: 96px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .why-compare {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .compare-card {
    border-radius: 12px;
    padding: 30px 32px;
  }

  .compare-before {
    background: var(--lt-gray);
  }

  .compare-after {
    background: var(--navy);
  }

  .compare-lbl {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .compare-before .compare-lbl {
    color: var(--text-mid);
  }
  .compare-after .compare-lbl {
    color: var(--gold);
  }

  .compare-card ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .compare-card li {
    font-size: 14px;
    line-height: 1.55;
    padding-left: 20px;
    position: relative;
  }
  .compare-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 2px;
  }

  .compare-before li {
    color: var(--text-mid);
  }
  .compare-before li::before {
    background: var(--mid-gray);
  }

  .compare-after li {
    color: rgba(255, 255, 255, 0.75);
  }
  .compare-after li::before {
    background: var(--gold);
  }

  @media (max-width: 960px) {
    .app-why {
      grid-template-columns: 1fr;
      padding: 64px 28px;
      gap: 40px;
    }
  }
</style>
