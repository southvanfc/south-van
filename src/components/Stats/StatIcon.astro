---
/** A coloured stat icon for the stats table headers. Size and colour are set on the svg itself. */
interface Props {
  icon: "calendar" | "ball" | "assist" | "star" | "yellow" | "red" | "shield";
  color: string;
}

const { icon, color } = Astro.props;
---

<svg class="st-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style={`color:${color}`}>
  {icon === "calendar" && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {icon === "ball" && (
    <>
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M12 8l3.8 2.8-1.5 4.4H9.7l-1.5-4.4z" fill="currentColor" />
      <path d="M12 8V3.2M15.8 10.8l4.6-1.5M14.3 15.2l2.8 3.9M9.7 15.2l-2.8 3.9M8.2 10.8L3.6 9.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </>
  )}
  {icon === "assist" && (
    <>
      <path d="M3 17c4 0 6-2 8-6s4-5 8-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path d="M15 3.5l4.5 2.5L17 10.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="4.5" cy="19" r="2" fill="currentColor" />
    </>
  )}
  {icon === "star" && (
    <path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z" fill="currentColor" />
  )}
  {(icon === "yellow" || icon === "red") && <rect x="6" y="3" width="12" height="18" rx="2" fill="currentColor" />}
  {icon === "shield" && (
    <>
      <path d="M12 2.8l7.5 2.7v6c0 4.6-3.1 8.2-7.5 9.7-4.4-1.5-7.5-5.1-7.5-9.7v-6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      <path d="M8.5 12.2l2.5 2.5 4.5-4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>

<style>
  .st-icon {
    width: 18px;
    height: 18px;
    flex: none;
  }
</style>
