---
import { leadersBy, type StatKey } from "../../lib/players";
import type { PlayersData } from "../../types/types";

interface Props {
  data: PlayersData;
  /** Show a link through to the full stats page */
  showLink?: boolean;
}

const { data, showLink = false } = Astro.props;

const cards: { stat: StatKey; title: string; unit: string }[] = [
  { stat: "goals", title: "Top Scorers", unit: "Goals" },
  { stat: "assists", title: "Top Assists", unit: "Assists" },
  { stat: "mvps", title: "MVP Awards", unit: "MVPs" },
];

/** Rows shown on a card. Anyone past this is only in the "View all" modal. */
const CARD_LIMIT = 5;

const built = cards.map((card) => {
  const all = leadersBy(data, card.stat, Infinity);
  return { ...card, all, leaders: all.slice(0, CARD_LIMIT) };
});
---

<section class="tl" aria-labelledby="tl-heading">
  <div class="fx-shell">
    <span class="eyebrow eyebrow-navy">{data.season} Season</span>
    <h2 class="tl-title" id="tl-heading">Team Leaders</h2>
    <div class="tl-grid">
      {
        built.map(({ stat, title, unit, all, leaders }) => (
          <div class="tl-card">
            <h3 class="tl-card-title">{title}</h3>
            {leaders.length > 0 ? (
              <ol class="tl-list">
                {leaders.map((leader) => (
                  <li class="tl-row">
                    <span class="tl-rank">{leader.rank}</span>
                    <span class="tl-name">{leader.name}</span>
                    <span class="tl-value">
                      {leader.value}
                      <span class="tl-unit">{unit}</span>
                    </span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="tl-empty">Nothing recorded yet this season.</p>
            )}
            {all.length > leaders.length && (
              <>
                <button type="button" class="tl-more" data-tl-open={`tl-modal-${stat}`}>
                  View all {all.length} <span aria-hidden="true">→</span>
                </button>
                <dialog class="tl-modal" id={`tl-modal-${stat}`} aria-labelledby={`tl-modal-${stat}-title`}>
                  <div class="tl-modal-head">
                    <h3 class="tl-modal-title" id={`tl-modal-${stat}-title`}>{title}</h3>
                    <button type="button" class="tl-modal-close" data-tl-close aria-label={`Close ${title}`}>
                      <span aria-hidden="true">×</span>
                    </button>
                  </div>
                  <ol class="tl-list">
                    {all.map((leader) => (
                      <li class="tl-row">
                        <span class="tl-rank">{leader.rank}</span>
                        <span class="tl-name">{leader.name}</span>
                        <span class="tl-value">
                          {leader.value}
                          <span class="tl-unit">{unit}</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </dialog>
              </>
            )}
          </div>
        ))
      }
    </div>
    <p class="tl-note">
      Goals and MVPs are from the Vancouver Metro Soccer League's official player
      stats for league matches. Assists are tracked by the club.
    </p>
    {
      showLink && (
        <a class="tl-link" href="/stats/">
          Full player stats
        </a>
      )
    }
  </div>
</section>

<script>
  /* Native <dialog>: showModal gives focus trapping and Escape to close. A click
     on the backdrop lands on the dialog itself, so that closes it too. */
  document.querySelectorAll<HTMLButtonElement>("[data-tl-open]").forEach((button) => {
    const dialog = document.getElementById(button.dataset.tlOpen ?? "") as HTMLDialogElement | null;
    if (!dialog) return;
    button.addEventListener("click", () => dialog.showModal());
    dialog.querySelector("[data-tl-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .tl {
    background: var(--off-white);
    padding: 64px 80px;
  }
  .tl-title {
    margin: 8px 0 28px;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--navy);
  }
  .tl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .tl-card {
    background: var(--white);
    border: 1px solid var(--mid-gray);
    border-top: 3px solid var(--gold);
    border-radius: 10px;
    padding: 24px;
  }
  .tl-card-title {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-mid);
  }
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-row {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: baseline;
    gap: 8px;
    padding: 10px 0;
    border-top: 1px solid var(--lt-gray);
    color: var(--text-dark);
  }
  .tl-row:first-child {
    border-top: none;
  }
  .tl-rank {
    font-weight: 700;
    color: var(--text-mid);
    font-variant-numeric: tabular-nums;
  }
  .tl-name {
    font-weight: 600;
  }
  .tl-value {
    font-size: 22px;
    font-weight: 800;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .tl-unit {
    margin-left: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-mid);
  }
  .tl-more {
    margin-top: 14px;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .tl-more:hover {
    color: var(--navy-dark);
  }
  .tl-modal {
    width: min(440px, calc(100vw - 32px));
    max-height: min(80vh, 640px);
    padding: 24px;
    border: none;
    border-top: 3px solid var(--gold);
    border-radius: 10px;
    background: var(--white);
    color: var(--text-dark);
    overflow-y: auto;
  }
  .tl-modal::backdrop {
    background: rgba(10, 20, 45, 0.6);
  }
  .tl-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .tl-modal-title {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-mid);
  }
  .tl-modal-close {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: var(--lt-gray);
    font-size: 22px;
    line-height: 1;
    color: var(--navy);
    cursor: pointer;
  }
  .tl-modal-close:hover {
    background: var(--mid-gray);
  }
  .tl-empty,
  .tl-note {
    margin: 0;
    color: var(--text-mid);
    font-size: 14px;
  }
  .tl-note {
    margin-top: 18px;
  }
  .tl-link {
    display: inline-block;
    margin-top: 14px;
    font-weight: 700;
    color: var(--navy);
    text-decoration: underline;
  }
  @media (max-width: 960px) {
    .tl-grid {
      grid-template-columns: 1fr;
    }
    .tl {
      padding: 48px 28px;
    }
  }
  @media (max-width: 640px) {
    .tl {
      padding: 40px 20px;
    }
    .tl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
